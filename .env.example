# Set these in Railway Variables. Never commit real values.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ANALYTICS_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_64_HEX_CHARACTERS
PHONE_KEY=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_CHARACTERS
PHONE_SALT=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_CHARACTERS
# Formal release only: create an Aliyun Phone Number Verification Service
# (PNVS / 号码认证服务) account, enable SMS Authentication, then copy the current
# system-provided matching sign/template from your own console. Historical
# gifted signs stopped working in August 2026. Never put actual keys here.
# ALIYUN_SMS_ACCESS_KEY_ID=SET_IN_RAILWAY_ONLY
# ALIYUN_SMS_ACCESS_KEY_SECRET=SET_IN_RAILWAY_ONLY
# ALIYUN_SMS_SIGN_NAME=COPY_CURRENT_SYSTEM_SIGN_FROM_CONSOLE
# ALIYUN_SMS_TEMPLATE_CODE=COPY_MATCHING_SYSTEM_TEMPLATE_FROM_CONSOLE
# PHONE_GATE=1
# PHONE_SMS_DEV must be absent in Railway.
